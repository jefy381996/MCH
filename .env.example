# Copy to .env and fill in what you need. Everything is optional for a local demo.
# Never commit .env: it is git-ignored.

# ---- Backend (packages/price-engine) ----
PORT=8080
# Empty = keep prices in memory (lost on restart). For anything real, use Postgres:
# DATABASE_URL=postgres://mch:mch@localhost:5432/mch
DATABASE_URL=
# Only "demo" exists until a data provider is chosen (docs/DATA-PROVIDERS.md).
PRICE_SOURCE=demo
# DEMO_SEED=2026             # replay the same simulated market every time
# DEMO_SPEED=60              # simulated market runs this many times faster than real life
# DEMO_BACKFILL_DAYS=30      # simulated history created on an empty database
# POLL_INTERVAL_MS=5000
LOG_LEVEL=info
LOG_PRETTY=true
# Slack-compatible webhook for alerts (bad prices, provider down, stale oracle).
ALERT_WEBHOOK_URL=
# Browser origins allowed to call the API cross-origin (comma-separated).
CORS_ORIGINS=

# ---- Cardano (packages/chain) ----
CARDANO_NETWORK=Preprod
# koios needs no account; blockfrost needs a free project id from blockfrost.io
CARDANO_PROVIDER=koios
BLOCKFROST_PROJECT_ID=
# The record written by `npm run chain:mint-coin` / `chain:deploy`, e.g. deployments/mainnet.json.
# Setting it turns on the website's coin and oracle panels.
ORACLE_DEPLOYMENT_FILE=
# Seeds normally live in secrets/*.seed (created by `npm run chain:wallets`).
# On a hosting platform, set them as secret environment variables instead.
ADMIN_SEED=
OPERATOR_SEED=

# Real Cardano is locked until you set this to yes (see docs/MAINNET-COIN.md).
MCH_MAINNET_ACKNOWLEDGED=

# ---- The MCH coin (used once, by `npm run chain:mint-coin` or `chain:deploy`) ----
# Permanent: asset name, supply and decimals can never change after creation.
TOKEN_NAME=MCH
TOKEN_SUPPLY=100000000
TOKEN_DECIMALS=6
# Shown by wallets. To use one, delete the # at the start of its line.
# (They can be changed on-chain after creation, with a metadata-update command.)
# TOKEN_DISPLAY_NAME=Metal Chain
# TOKEN_TICKER=MCH
# TOKEN_DESCRIPTION=MCH tracks the MCH Index of gold, silver, platinum and nickel. Not backed by metal and not redeemable.
# A permanent link starting with https://, ipfs:// or ar://
# TOKEN_LOGO=
# TOKEN_URL=

# ---- Oracle submitter (`npm run chain:submitter`) ----
PRICE_API_URL=http://localhost:8080
DEVIATION_PCT=0.5
HEARTBEAT_MINUTES=60
SUBMIT_INTERVAL_MS=60000
