      "title": "TokenSettings",
      "description": "Fixed parameters of the MCH token.",
      "anyOf": [
        {
          "title": "TokenSettings",
          "dataType": "constructor",
          "index": 0,
          "fields": [
            {
              "title": "admin",
              "description": "Key that mints the supply (once) and may update the token metadata.",
              "$ref": "#/definitions/aiken~1crypto~1VerificationKeyHash"
            },
            {
              "title": "seed",
              "description": "UTxO consumed by the single mint, so the supply can never be increased.",
              "$ref": "#/definitions/cardano~1transaction~1OutputReference"
            },
            {
              "title": "name",
              "description": "Asset name without its CIP-67 label, e.g. \"MCH\".",
              "$ref": "#/definitions/ByteArray"
            },
            {
              "title": "supply",
              "description": "Entire supply in base units. Decimals are a display convention.",
              "$ref": "#/definitions/Int"
