    "mch/types/OracleSettings": {
      "title": "OracleSettings",
      "description": "Fixed for the lifetime of an oracle deployment. Changing anything here\n gives a different script hash, which is a new, separately announced feed.\n That is deliberate: nobody can quietly re-weight the basket.",
      "anyOf": [
        {
          "title": "OracleSettings",
          "dataType": "constructor",
          "index": 0,
          "fields": [
            {
              "title": "admin",
              "description": "Cold key. Creates and closes the feed and rotates the operator key.",
              "$ref": "#/definitions/aiken~1crypto~1VerificationKeyHash"
            },
            {
              "title": "seed",
              "description": "UTxO consumed when the feed is created, so the auth NFT can only ever\n be minted once.",
              "$ref": "#/definitions/cardano~1transaction~1OutputReference"
            },
            {
              "title": "basket_version",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "basket",
              "$ref": "#/definitions/List<mch~1types~1Component>"
            },
            {
              "title": "max_validity_ms",
              "description": "Widest validity range an update may use. Bounds how far `published_at`\n can sit from the real time at which the ledger accepted the update.",
              "$ref": "#/definitions/Int"
            }
          ]
        }
      ]
    },
