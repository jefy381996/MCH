          "fields": [
            {
              "title": "transaction_id",
              "$ref": "#/definitions/ByteArray"
            },
            {
              "title": "output_index",
              "$ref": "#/definitions/Int"
            }
          ]
        }
      ]
    },
    "mch/types/Component": {
      "title": "Component",
      "description": "One metal in the basket. Mirrors `BasketComponent` in packages/index-core.",
      "anyOf": [
        {
          "title": "Component",
          "dataType": "constructor",
          "index": 0,
          "fields": [
            {
              "title": "metal",
              "description": "Metal code as UTF-8 bytes, e.g. \"XAU\".",
              "$ref": "#/definitions/ByteArray"
            },
            {
              "title": "weight_ppm",
              "description": "Share of the index in parts per million. All weights sum to 1_000_000.",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "base_price",
              "description": "Base-date price in micro-USD per the metal's unit.",
              "$ref": "#/definitions/Int"
            }
          ]
        }
      ]
    },
    "mch/types/OracleDatum": {
      "title": "OracleDatum",
      "description": "The on-chain state of the feed, held as an inline datum next to the auth NFT.",
      "anyOf": [
        {
          "title": "OracleDatum",
          "dataType": "constructor",
          "index": 0,
          "fields": [
            {
              "title": "index",
              "description": "MCH index in micro-points (index x 10^6). Always equal to the index\n recomputed from `prices`; the validator enforces it.",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "prices",
              "description": "Micro-USD price of each basket metal, in basket order.",
              "$ref": "#/definitions/List<Int>"
            },
            {
              "title": "published_at",
              "description": "POSIX milliseconds at which the operator attests these prices are current.",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "sequence",
              "description": "Starts at 0 and increases by exactly 1 with every price update.",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "basket_version",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "operator",
              "description": "Hot key allowed to publish price updates. The admin can rotate it.",
              "$ref": "#/definitions/aiken~1crypto~1VerificationKeyHash"
            }
          ]
        }
      ]
    },
