// all prices at base -> exactly 100
test vector_001() {
  compute_index(
    [
      Component { metal: "XAU", weight_ppm: 250000, base_price: 4000000000 },
      Component { metal: "XAG", weight_ppm: 250000, base_price: 48000000 },
      Component { metal: "XPT", weight_ppm: 250000, base_price: 1600000000 },
      Component { metal: "NI", weight_ppm: 250000, base_price: 15500000000 },
    ],
    [4000000000, 48000000, 1600000000, 15500000000],
  ) == 100000000
}

